<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Pastepad.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pastepad.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Le tre tavolozze di sistema. Con {ThemeResource} nello
                XAML, WinUI le rivaluta ogni volta che il tema cambia a
                caldo; con {StaticResource} si leggerebbero solo al
                caricamento. Fonte: learn.microsoft.com, "XAML theme
                resources".

                Dentro un ThemeDictionary i colori vanno con
                {StaticResource}, tranne i SystemColor* di HighContrast,
                che la stessa guida indica come l'eccezione.

                I valori di Light e Dark sono quelli della sezione 2 di
                docs/SPECIFICHE-UI.md. Stile.Applica() li cambia sul
                posto quando l'utente sceglie uno degli altri dieci
                sfondi, che sono nostri e non di sistema.
            -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PpSfondoColor">#F6F6F4</Color>
                    <Color x:Key="PpElevatoColor">#FFFFFF</Color>
                    <Color x:Key="PpRiquadroColor">#FFFFFF</Color>
                    <Color x:Key="PpHoverColor">#EFEFEC</Color>
                    <Color x:Key="PpBordoColor">#E6E6E2</Color>
                    <Color x:Key="PpTestoColor">#141416</Color>
                    <Color x:Key="PpMedioColor">#5C5C66</Color>
                    <Color x:Key="PpTenueColor">#707079</Color>
                    <Color x:Key="PpAccentoColor">#2DD4A7</Color>
                    <Color x:Key="PpSopraColor">#052E23</Color>
                    <Color x:Key="PpRossoColor">#EF4444</Color>
                    <Color x:Key="PpAmbraColor">#F5A524</Color>
                    <Color x:Key="PpPericoloColor">#DC2626</Color>
                    <Color x:Key="PpBarraFocusColor">#FFFFFF</Color>

                    <SolidColorBrush x:Key="PpSfondo" Color="{StaticResource PpSfondoColor}" />
                    <SolidColorBrush x:Key="PpElevato" Color="{StaticResource PpElevatoColor}" />
                    <SolidColorBrush x:Key="PpRiquadro" Color="{StaticResource PpRiquadroColor}" />
                    <SolidColorBrush x:Key="PpHover" Color="{StaticResource PpHoverColor}" />
                    <SolidColorBrush x:Key="PpBordo" Color="{StaticResource PpBordoColor}" />
                    <SolidColorBrush x:Key="PpTesto" Color="{StaticResource PpTestoColor}" />
                    <SolidColorBrush x:Key="PpMedio" Color="{StaticResource PpMedioColor}" />
                    <SolidColorBrush x:Key="PpTenue" Color="{StaticResource PpTenueColor}" />
                    <SolidColorBrush x:Key="PpAccento" Color="{StaticResource PpAccentoColor}" />
                    <SolidColorBrush x:Key="PpSopra" Color="{StaticResource PpSopraColor}" />
                    <SolidColorBrush x:Key="PpRosso" Color="{StaticResource PpRossoColor}" />
                    <SolidColorBrush x:Key="PpAmbra" Color="{StaticResource PpAmbraColor}" />
                    <SolidColorBrush x:Key="PpPericolo" Color="{StaticResource PpPericoloColor}" />
                    <SolidColorBrush x:Key="PpBarraFocus" Color="{StaticResource PpBarraFocusColor}" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PpSfondoColor">#0B0B0D</Color>
                    <Color x:Key="PpElevatoColor">#141417</Color>
                    <Color x:Key="PpRiquadroColor">#1B1B1F</Color>
                    <Color x:Key="PpHoverColor">#26262B</Color>
                    <Color x:Key="PpBordoColor">#242429</Color>
                    <Color x:Key="PpTestoColor">#F4F4F5</Color>
                    <Color x:Key="PpMedioColor">#9C9CA6</Color>
                    <Color x:Key="PpTenueColor">#86868E</Color>
                    <Color x:Key="PpAccentoColor">#2DD4A7</Color>
                    <Color x:Key="PpSopraColor">#052E23</Color>
                    <Color x:Key="PpRossoColor">#EF4444</Color>
                    <Color x:Key="PpAmbraColor">#F5A524</Color>
                    <Color x:Key="PpPericoloColor">#DC2626</Color>
                    <Color x:Key="PpBarraFocusColor">#FFFFFF</Color>

                    <SolidColorBrush x:Key="PpSfondo" Color="{StaticResource PpSfondoColor}" />
                    <SolidColorBrush x:Key="PpElevato" Color="{StaticResource PpElevatoColor}" />
                    <SolidColorBrush x:Key="PpRiquadro" Color="{StaticResource PpRiquadroColor}" />
                    <SolidColorBrush x:Key="PpHover" Color="{StaticResource PpHoverColor}" />
                    <SolidColorBrush x:Key="PpBordo" Color="{StaticResource PpBordoColor}" />
                    <SolidColorBrush x:Key="PpTesto" Color="{StaticResource PpTestoColor}" />
                    <SolidColorBrush x:Key="PpMedio" Color="{StaticResource PpMedioColor}" />
                    <SolidColorBrush x:Key="PpTenue" Color="{StaticResource PpTenueColor}" />
                    <SolidColorBrush x:Key="PpAccento" Color="{StaticResource PpAccentoColor}" />
                    <SolidColorBrush x:Key="PpSopra" Color="{StaticResource PpSopraColor}" />
                    <SolidColorBrush x:Key="PpRosso" Color="{StaticResource PpRossoColor}" />
                    <SolidColorBrush x:Key="PpAmbra" Color="{StaticResource PpAmbraColor}" />
                    <SolidColorBrush x:Key="PpPericolo" Color="{StaticResource PpPericoloColor}" />
                    <SolidColorBrush x:Key="PpBarraFocus" Color="{StaticResource PpBarraFocusColor}" />
                </ResourceDictionary>

                <!--
                    In alto contrasto non si inventano colori: li sceglie
                    l'utente nelle impostazioni di Windows e coprirli è
                    proprio ciò che rompe l'accessibilità che ha attivato.
                    Qui sì va {ThemeResource}, che è l'eccezione indicata
                    dalla guida.
                -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PpSfondo" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PpElevato" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PpRiquadro" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PpHover" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PpBordo" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PpTesto" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PpMedio" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PpTenue" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PpAccento" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PpSopra" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PpRosso" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PpAmbra" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PpPericolo" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PpBarraFocus" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="PpNiente" Color="Transparent" />

            <!--
                Segoe UI Variable Display su Windows 11; Segoe UI se non
                c'è. XAML passa da solo al nome successivo della lista.
            -->
            <x:String x:Key="PpCarattere">Segoe UI Variable Display, Segoe UI</x:String>

            <!--
                I tre cerchi dell'intestazione. Lato 20 perché le
                maquette li disegnano con raggio 10; il minimo che WinUI
                dà a un Button è 32x32 e sballava l'intera intestazione,
                quindi vanno con altezza e larghezza esplicite.
            -->
            <Style x:Key="PpIconaIntestazione" TargetType="Button">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource PpRiquadro}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource PpMedio}" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--  Quelli del piede: senza sfondo, più grandi, raggio 10.  -->
            <Style x:Key="PpIconaPiede" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="26" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{StaticResource PpNiente}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource PpMedio}" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--
                Pulsanti del piede. Altezza 26 esplicita: il minimo di
                WinUI è 32 e le maquette chiedono 26.
            -->
            <Style x:Key="PpPulsante" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource PpRiquadro}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource PpTesto}" />
                <Setter Property="FontFamily" Value="{StaticResource PpCarattere}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="PpPulsanteAccento"
                BasedOn="{StaticResource PpPulsante}"
                TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource PpAccento}" />
                <Setter Property="Foreground" Value="{ThemeResource PpSopra}" />
            </Style>

            <!--  Schede e tessere di cartella: capsula di 30 px.  -->
            <Style x:Key="PpScheda" TargetType="Button">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Background" Value="{ThemeResource PpRiquadro}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource PpMedio}" />
                <Setter Property="FontFamily" Value="{StaticResource PpCarattere}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="PpTestoRiga" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PpCarattere}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="MaxLines" Value="1" />
            </Style>

            <Style x:Key="PpSottotitoloRiga" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PpCarattere}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
