<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pastepad.App</RootNamespace>
    <AssemblyName>pastepad</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!--
      Ciò che Windows mostra nelle Proprietà del file, e da dove esce
      Config.Version. Senza questo CompanyName diceva "pastepad" —il
      nome dell'assembly, perché nessuno l'aveva messo— e
      LegalCopyright era vuoto.

      Version NON si fissa qui apposta: la mette il CI con
      -p:Version=<tag>. Scritta nel file resta vecchia, e fu già
      pubblicata una release con binari vecchi per averla inchiodata in
      dodici posti (errore 4 di PASSAGGIO.md). In una build da
      scrivania esce 1.0.0, che è proprio ciò che si deve vedere fuori
      da una release.
    -->
    <Product>pastepad</Product>
    <AssemblyTitle>pastepad</AssemblyTitle>
    <Description>pastepad - gestore di appunti per Windows</Description>
    <!--
      L'utente di GitHub e non il nome reale: questo finisce dentro
      l'.exe come CompanyName, che si vede nelle proprietà del file e
      che il CI stampa quando controlla ciò che è pubblicato.
    -->
    <Company>Josemgu</Company>
    <Authors>Josemgu</Authors>
    <Copyright>Copyright (c) 2026 Josemgu. Licenza MIT.</Copyright>

    <!--
      Senza il "+<sha>" che l'SDK aggiunge alla versione informativa.
      Ciò che si mostra in Proprietà e in Installazione applicazioni è
      "4.0.0" e non "4.0.0+4bbe758f...". Il commit non si perde: una
      release esce sempre da un tag. Config.Version continua a dividere
      per "+" per sicurezza, che non costa niente.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <!--
      Il runtime segue la piattaforma chiesta, e solo se non ne è stata
      chiesta nessuna si prende quella della macchina. Dedurlo sempre
      dalla macchina faceva fallire la compilazione dalla soluzione con
      NETSDK1032 ogni volta che le due non coincidevano.
    -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == 'x86' or '$(Platform)' == 'x64' or '$(Platform)' == 'ARM64')">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Lo chiede il generatore di LibraryImport, che produce il codice
      di interoperabilità con puntatori. Nel progetto non c'è nemmeno
      un blocco unsafe scritto a mano.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Non impacchettato e con il runtime dentro: è ciò che permette di
      installare in %LOCALAPPDATA% con un installer proprio e di
      avviarsi su una macchina che non ha il Windows App SDK. Vedi
      PIANO.md.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>

    <!-- Main proprio: l'istanza unica si decide prima di creare finestre. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    CopyToPublishDirectory in tutti: senza, publish lascia la cartella
    Assets vuota. AppIcon.ico serve davvero —AreaNotifica lo carica dal
    disco con LoadImage, e senza l'area di notifica ricade sull'icona
    generica di Windows—, e gli altri si copiano perché ciò che è
    pubblicato e ciò che è compilato abbiano lo stesso contenuto. Meno
    si somigliano, più errori compaiono solo in ciò che si distribuisce.
  -->
  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Definire qui la ProjectCapability "Msix" permette di attivare
    l'estensione Single-project MSIX Packaging Tools per questo progetto
    anche se il pacchetto NuGet del Windows App SDK non è ancora stato
    ripristinato.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp aggiunge il supporto a
    `dotnet run` per le app WinUI impacchettate: aggancia il target Run
    della CLI .NET per registrare un'identità di debug tramite la CLI
    winapp e lanciare l'app con identità di pacchetto (AUMID).
    Per escluderlo, impostare
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in un
    <PropertyGroup> qui sopra.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pastepad.Nucleo\Pastepad.Nucleo.csproj" />
  </ItemGroup>

  <!--
    Definire qui la proprietà "HasPackageAndPublishMenuAddedByProject"
    permette di abilitare la voce "Package and Publish" del menu
    contestuale di Esplora soluzioni per questo progetto anche se il
    pacchetto NuGet del Windows App SDK non è ancora stato ripristinato.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Lo XAML compilato (.xbf) nella cartella di publish.

    Senza questo, `dotnet publish` lascia fuori App.xbf e Pannello.xbf e
    il programma pubblicato MUORE ALL'AVVIO con XamlParseException nel
    costruttore di Pannello. La compilazione normale funziona, quindi
    l'errore si vede solo eseguendo ciò che si distribuirà — l'errore 5
    di PASSAGGIO.md, "provare l'eseguibile, non solo il codice
    sorgente".

    Il motivo: il task CopyGeneratedXaml del Windows App SDK copia gli
    .xbf nella cartella di output e li annota solo in @(FileWrites). Per
    un'applicazione impacchettata li raccoglie dopo l'impacchettatore
    MSIX; non impacchettata e pubblicata con dotnet publish non li
    raccoglie nessuno, perché publish costruisce la sua lista da
    @(ResolvedFileToPublish). Qui si aggiungono a quella lista.
  -->
  <Target Name="PubblicaXamlCompilato"
          DependsOnTargets="ComputeProcessXamlFiles"
          BeforeTargets="ComputeResolvedFilesToPublishList">

    <ItemGroup>
      <_XamlCompilato Include="@(ProcessedXamlFiles->'%(FullPath)')" />
    </ItemGroup>

    <!-- Come fa lo stesso SDK impacchettando: conserva le
         sottocartelle se un giorno una pagina XAML smette di stare
         nella radice del progetto. -->
    <AssignTargetPath Files="@(_XamlCompilato)" RootFolder="$(OutputPath)">
      <Output TaskParameter="AssignedFiles" ItemName="_XamlCompilatoConDestinazione" />
    </AssignTargetPath>

    <ItemGroup>
      <ResolvedFileToPublish Include="@(_XamlCompilatoConDestinazione)">
        <RelativePath>%(TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>

      <!--
        E l'indice delle risorse dell'applicazione, che resta fuori per
        lo stesso motivo. È quello che risolve
        ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml: senza,
        con gli .xbf già al loro posto, l'avvio continua a morire —
        solo un passo più avanti.
      -->
      <ResolvedFileToPublish Include="$(OutputPath)$(TargetName).pri"
                             Condition="Exists('$(OutputPath)$(TargetName).pri')">
        <RelativePath>$(TargetName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>

    <!--
      Che non si possa pubblicare in silenzio senza l'indice: l'errore
      che provoca non somiglia per niente alla sua causa.
    -->
    <Error Condition="!Exists('$(OutputPath)$(TargetName).pri')"
           Text="Non esiste $(OutputPath)$(TargetName).pri. Senza l'indice delle risorse, ciò che è pubblicato si avvia e muore con XamlParseException." />

    <Message Importance="high"
             Text="Si pubblicano: @(_XamlCompilatoConDestinazione->'%(TargetPath)'), $(TargetName).pri" />
  </Target>

  <!-- Proprietà di publish -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Senza trimming: la guida sull'istanza unica avverte di errori con il trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
