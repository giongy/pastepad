{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compila",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/csharp/Pastepad.App",
                "-p:Platform=x64",
                "-r",
                "win-x64",
                "-nologo",
                "-v:minimal"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "prove",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/csharp/Pastepad.Nucleo.Prove",
                "-nologo"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        }
    ]
}
